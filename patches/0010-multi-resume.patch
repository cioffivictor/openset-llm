+// 0010: a state file is sealed with a 16-byte trailer (magic + the length of what precedes it) once it is complete on
+// disk. The loader ignores bytes after the state. A file without a matching trailer (cut short: a full disk, a copy
+// that broke off) is never handed to the loader, which aborts the server on it.
+static const char RSM_SEAL[8] = { 'R', 'S', 'M', 'S', 'E', 'A', 'L', '1' };
+static bool rsm_seal(const std::string & path, uint64_t n) {
+    std::error_code ec;
+    if (n == 0 || std::filesystem::file_size(path, ec) != n || ec) { return false; }
+    std::ofstream f(path, std::ios::binary | std::ios::app);
+    f.write(RSM_SEAL, sizeof(RSM_SEAL));
+    f.write((const char *) &n, sizeof(n));
+    f.flush();
+    return (bool) f;
+}
+static bool rsm_sealed(const std::string & path) {
+    std::error_code ec;
+    const uint64_t sz = std::filesystem::file_size(path, ec);
+    if (ec || sz < 16) { return false; }
+    std::ifstream f(path, std::ios::binary);
+    f.seekg((std::streamoff) (sz - 16));
+    char m[sizeof(RSM_SEAL)];
+    uint64_t n = 0;
+    f.read(m, sizeof(m));
+    f.read((char *) &n, sizeof(n));
+    return f && std::equal(m, m + sizeof(m), RSM_SEAL) && n == sz - 16;
+}
